{
  "name": "preact-view-transition-group",
  "version": "0.1.1",
  "description": "Animate Preact children as they are added, removed, moved and resized with element-scoped View Transitions",
  "keywords": [
    "animation",
    "flip",
    "list",
    "preact",
    "transition-group",
    "view-transition",
    "view-transitions"
  ],
  "homepage": "https://fakundo.github.io/preact-view-transition-group/",
  "bugs": {
    "url": "https://github.com/fakundo/preact-view-transition-group/issues"
  },
  "license": "MIT",
  "author": "Roman Samoylov (https://github.com/fakundo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fakundo/preact-view-transition-group.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite demo --config vite.config.ts",
    "build": "oxlint && tsc && vite build",
    "build:demo": "tsc && vite build --mode demo",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "commitlint": "commitlint",
    "prepublishOnly": "npm test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@typescript/typescript6": "^6.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "preact": "^11.0.0",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "preact": "^11.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
